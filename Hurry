-- PART 3: Helper Functions & Automation (Fixed Anti-Crash)
local rng = Random.new()
local function getHumanizedWait() return rng:NextNumber(8.0, 15.0) end

-- Optimized prompt canceler (Ignores MasterHubUI & Chat to prevent crashes)
local function cancelActivePrompts()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return end
    
    for _, gui in ipairs(playerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled and gui.Name ~= "MasterHubUI" and gui.Name ~= "Chat" and gui.Name ~= "BubbleChat" then
            for _, desc in ipairs(gui:GetDescendants()) do
                if (desc:IsA("TextButton") or desc:IsA("ImageButton")) and desc.Visible then
                    local btnText = desc:IsA("TextButton") and desc.Text:lower() or ""
                    local btnName = desc.Name:lower()
                    if btnText:find("cancel") or btnText:find("close") or btnText:find("no") or btnName:find("cancel") then
                        pcall(function()
                            if firesignal then
                                firesignal(desc.MouseButton1Click)
                            else
                                desc.Visible = false
                            end
                        end)
                    end
                end
            end
        end
    end
end

-- Optimized quest text verifier
local function isEgoQuestActive()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    
    for _, gui in ipairs(playerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled and gui.Name ~= "MasterHubUI" and gui.Name ~= "Chat" then
            for _, desc in ipairs(gui:GetDescendants()) do
                if desc:IsA("TextLabel") and desc.Visible then
                    local text = desc.Text:lower()
                    if text:find("destruction ki") or text:find("ultra ego") or text:find("vegetadestructionki") then
                        return true
                    end
                end
            end
        end
    end
    return false
end

-- 1. Standard Auto Quest Loop
task.spawn(function()
    while true do
        if autoQuestActive and not autoRoGActive then
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
