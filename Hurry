-- 2. Realm of Gods Auto Farm Quest Controller
task.spawn(function()
    while true do
        if autoRoGActive then
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local giveQuests = remotes and remotes:FindFirstChild("giveQuests")
            local bossesFolder = workspace:FindFirstChild("Bosses")
            
            local egoBoss = bossesFolder and bossesFolder:FindFirstChild("VegetaUltraEgoQuest")
            local isEgoAlive = egoBoss and egoBoss:FindFirstChild("Humanoid") and egoBoss.Humanoid.Health > 0
            
            if isEgoAlive then
                if not isEgoQuestActive() then
                    cancelActivePrompts()
                    task.wait(0.5)
                    
                    if giveQuests and giveQuests:IsA("RemoteEvent") then
                        giveQuests:FireServer("VegetaDestructionKi")
                    end
                    task.wait(1.5)
                end
                
                egoQuestGrabbed = isEgoQuestActive()
            else
                egoQuestGrabbed = false
                if giveQuests and giveQuests:IsA("RemoteEvent") then
                    giveQuests:FireServer("VegetaChamber")
                end
                
                local startWait = tick()
                local waitDuration = getHumanizedWait()
                while autoRoGActive and (tick() - startWait < waitDuration) do
                    local checkEgo = bossesFolder and bossesFolder:FindFirstChild("VegetaUltraEgoQuest")
                    if checkEgo and checkEgo:FindFirstChild("Humanoid") and checkEgo.Humanoid.Health > 0 then
                        cancelActivePrompts()
                        break
                    end
                    task.wait(1)
                end
            end
        else
            egoQuestGrabbed = false
            task.wait(1)
        end
    end
end)

-- 3. Client Loop (Bring Bosses & Float)
RunService.Heartbeat:Connect(function()
    local playerChar = LocalPlayer.Character
    if playerChar and playerChar:FindFirstChild("HumanoidRootPart") then
        local hrp = playerChar.HumanoidRootPart
        local targetCFrame = hrp.CFrame * CFrame.new(0, 0, -4) 
        local bossesFolder = workspace:FindFirstChild("Bosses")

        -- Realm of Gods Bring Logic
        if autoRoGActive and bossesFolder then
            local egoBoss = bossesFolder:FindFirstChild("VegetaUltraEgoQuest")
            local isEgoAlive = egoBoss and egoBoss:FindFirstChild("Humanoid") and egoBoss.Humanoid.Health > 0

            if isEgoAlive then
                if egoQuestGrabbed and egoBoss:FindFirstChild("HumanoidRootPart") then
                    egoBoss.HumanoidRootPart.CFrame = targetCFrame
                end
            else
                for _, boss in ipairs(bossesFolder:GetChildren()) do
                    if boss:IsA("Model") and boss:FindFirstChild("HumanoidRootPart") and boss:FindFirstChild("Humanoid") then
                        if boss.Humanoid.Health > 0 then
                            boss.HumanoidRootPart.CFrame = targetCFrame
                        end
                    end
                end
            end
        end

        -- Float
        if autoFloatActive then
            if hrp.Position.Y < 4900 then hrp.CFrame = CFrame.new(hrp.Position.X, 5000, hrp.Position.Z) end
            hrp.Velocity = Vector3.new(0, 0, 0)
        end

        -- Bring Normal
        if autoBringActive and not autoRoGActive then
            if bossesFolder then
                local foundBoss = false
                for _, boss in ipairs(bossesFolder:GetChildren()) do
                    if boss:IsA("Model") and boss:FindFirstChild("HumanoidRootPart") and boss:FindFirstChild("Humanoid") then
                        if boss.Humanoid.Health > 0 then 
                            boss.HumanoidRootPart.CFrame = targetCFrame 
                            foundBoss = true
                        end
                    end
                end
                if not foundBoss then
                    local topBossesFolder = workspace:FindFirstChild("TOPBosses")
                    if topBossesFolder then
                        for _, boss in ipairs(topBossesFolder:GetChildren()) do
                            if boss:IsA("Model") and boss:FindFirstChild("HumanoidRootPart") and boss:FindFirstChild("Humanoid") then
                                if boss.Humanoid.Health > 0 then boss.HumanoidRootPart.CFrame = targetCFrame end
                            end
                        end
                    end
                end
            end
        end

        -- Bring TOP
        if autoBringTopActive and not autoRoGActive then
            local topBossesFolder = workspace:FindFirstChild("TOPBosses")
            if topBossesFolder then
                for _, boss in ipairs(topBossesFolder:GetChildren()) do
                    if boss:IsA("Model") and boss:FindFirstChild("HumanoidRootPart") and boss:FindFirstChild("Humanoid") then
                        if boss.Humanoid.Health > 0 then boss.HumanoidRootPart.CFrame = targetCFrame end
                    end
                end
            end
        end
    end
end)

