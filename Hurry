-- Dragging Logic
local dragging, dragInput, dragStart, startPos
titleLabel.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
titleLabel.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- PART 3: Helper Functions & Crash-Free Loops (With Wave Bring Integration)
local rng = Random.new()
local function getHumanizedWait() return rng:NextNumber(8.0, 15.0) end

-- 1. Standard Auto Quest Loop
task.spawn(function()
    while true do
        if autoQuestActive and not autoRoGActive then
            pcall(function()
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                local giveQuests = remotes and remotes:FindFirstChild("giveQuests")
                if giveQuests and giveQuests:IsA("RemoteEvent") then
                    giveQuests:FireServer(questTarget)
                end
            end)
            task.wait(getHumanizedWait())
        else
            task.wait(1)
        end
    end
end)

-- 2. Realm of Gods Auto Farm
task.spawn(function()
    while true do
        if autoRoGActive then
            pcall(function()
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                local giveQuests = remotes and remotes:FindFirstChild("giveQuests")
                local bossesFolder = workspace:FindFirstChild("Bosses")
                
                local egoBoss = bossesFolder and bossesFolder:FindFirstChild("VegetaUltraEgoQuest")
                local isEgoAlive = egoBoss and egoBoss:FindFirstChild("Humanoid") and egoBoss.Humanoid.Health > 0
                
                if isEgoAlive then
                    if not egoQuestGrabbed then
                        if giveQuests and giveQuests:IsA("RemoteEvent") then
                            giveQuests:FireServer("VegetaDestructionKi")
                            egoQuestGrabbed = true 
                        end
                    end
                else
                    egoQuestGrabbed = false
                    if giveQuests and giveQuests:IsA("RemoteEvent") then
                        giveQuests:FireServer("VegetaChamber")
                    end
                end
            end)
            task.wait(getHumanizedWait())
        else
            egoQuestGrabbed = false
            task.wait(1)
        end
    end
end)

-- 3. Ultra-Lightweight Bring Bosses, Wave NPCs, & Float Loop
task.spawn(function()
    while true do
        if autoRoGActive or autoFloatActive or autoBringActive or autoBringTopActive or autoWaveBringActive then
            pcall(function()
                local playerChar = LocalPlayer.Character
                if playerChar and playerChar:FindFirstChild("HumanoidRootPart") then
                    local hrp = playerChar.HumanoidRootPart
                    local targetCFrame = hrp.CFrame * CFrame.new(0, 0, -4) 
                    local bossesFolder = workspace:FindFirstChild("Bosses")

                    -- Realm of Gods Bring Logic
                    if autoRoGActive and bossesFolder then
                        local egoBoss = bossesFolder:FindFirstChild("VegetaUltraEgoQuest")
                        local isEgoAlive = egoBoss and egoBoss:FindFirstChild("Humanoid") and egoBoss.Humanoid.Health > 0

                        if isEgoAlive then
                            if egoQuestGrabbed and egoBoss:FindFirstChild("HumanoidRootPart") then
                                egoBoss.HumanoidRootPart.CFrame = targetCFrame
                            end
                        else
                            for _, boss in ipairs(bossesFolder:GetChildren()) do
                                if boss:IsA("Model") and boss:FindFirstChild("HumanoidRootPart") and boss:FindFirstChild("Humanoid") then
                                    if boss.Humanoid.Health > 0 then
                                        boss.HumanoidRootPart.CFrame = targetCFrame
                                    end
                                end
                            end
                        end
                    end

                    -- Float
                    if autoFloatActive then
                        if hrp.Position.Y < 4900 then hrp.CFrame = CFrame.new(hrp.Position.X, 5000, hrp.Position.Z) end
                        hrp.Velocity = Vector3.new(0, 0, 0)
                    end

                    -- Bring Normal
                    if autoBringActive and not autoRoGActive then
                        if bossesFolder then
                            local foundBoss = false
                            for _, boss in ipairs(bossesFolder:GetChildren()) do
                                if boss:IsA("Model") and boss:FindFirstChild("HumanoidRootPart") and boss:FindFirstChild("Humanoid") then
                                    if boss.Humanoid.Health > 0 then 
                                        boss.HumanoidRootPart.CFrame = targetCFrame 
                                        foundBoss = true
                                    end
                                end
                            end
                            if not foundBoss then
                                local topBossesFolder = workspace:FindFirstChild("TOPBosses")
                                if topBossesFolder then
                                    for _, boss in ipairs(topBossesFolder:GetChildren()) do
                                        if boss:IsA("Model") and boss:FindFirstChild("HumanoidRootPart") and boss:FindFirstChild("Humanoid") then
                                            if boss.Humanoid.Health > 0 then boss.HumanoidRootPart.CFrame = targetCFrame end
                                        end
                                    end
                                end
                            end
                        end
                    end

                    -- Bring TOP
                    if autoBringTopActive and not autoRoGActive then
                        local topBossesFolder = workspace:FindFirstChild("TOPBosses")
                        if topBossesFolder then
                            for _, boss in ipairs(topBossesFolder:GetChildren()) do
                                if boss:IsA("Model") and boss:FindFirstChild("HumanoidRootPart") and boss:FindFirstChild("Humanoid") then
                                    if boss.Humanoid.Health > 0 then boss.HumanoidRootPart.CFrame = targetCFrame end
                                end
                            end
                        end
                    end

                    -- Bring Wave Enemies (Scans workspace dynamically for dynamic wave entities)
                    if autoWaveBringActive then
                        for _, obj in ipairs(workspace:GetChildren()) do
                            if obj:IsA("Model") and obj ~= playerChar then
                                local humanoid = obj:FindFirstChildOfClass("Humanoid")
                                local rootPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
                                
                                if humanoid and rootPart and humanoid.Health > 0 then
                                    local isPlayer = false
                                    for _, p in ipairs(Players:GetPlayers()) do
                                        if p.Character == obj then
                                            isPlayer = true
                                            break
                                        end
                                    end
                                    
                                    if not isPlayer then
                                        rootPart.CFrame = targetCFrame
                                    end
                                end
                            end
                            
                            if obj:IsA("Folder") then
                                for _, subObj in ipairs(obj:GetChildren()) do
                                    if subObj:IsA("Model") then
                                        local humanoid = subObj:FindFirstChildOfClass("Humanoid")
                                        local rootPart = subObj:FindFirstChild("HumanoidRootPart") or subObj:FindFirstChild("Torso")
                                        
                                        if humanoid and rootPart and humanoid.Health > 0 then
                                            rootPart.CFrame = targetCFrame
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end)
            task.wait(0.1)
        else
            task.wait(0.5)
        end
    end
end)

