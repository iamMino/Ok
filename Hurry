-- 6. Auto Transform Loop
task.spawn(function()
    while true do
        if autoTransformActive then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                    local hasMUI = char:FindFirstChild("MUI")
                    local hasUI = char:FindFirstChild("UI") or char:FindFirstChild("Ui")
                    local ssjsFolder = ReplicatedStorage:FindFirstChild("ssjs")
                    if ssjsFolder then
                        if not hasUI and not hasMUI then
                            local uiRemote = ssjsFolder:FindFirstChild("UI")
                            if uiRemote then uiRemote:FireServer() end
                            task.wait(6)
                        elseif hasUI and not hasMUI then
                            local muiRemote = ssjsFolder:FindFirstChild("MUI")
                            if muiRemote then
                                muiRemote:FireServer()
                            else
                                local uiRemote = ssjsFolder:FindFirstChild("UI")
                                if uiRemote then uiRemote:FireServer() end
                            end
                            task.wait(6)
                        end
                    end
                end
            end)
        end
        task.wait(1)
    end
end)
